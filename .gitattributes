# Keep audited text artifacts byte-identical on Windows and Linux.
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.fasta text eol=lf
*.faa text eol=lf
*.hmm text eol=lf
*.clstr text eol=lf

# Two historical TSVs were originally committed with CRLF; preserve their bytes.
/data/processed/gv02_03/conserved_sites.tsv -text
/data/processed/gv02_03/reference_mapping.tsv -text

